DATABASE_URL=postgresql+psycopg://asm_user:CHANGE_ME@postgres:5432/asm_db
REDIS_URL=redis://redis:6379/0
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_RATE_LIMIT=10
SCAN_TIMEOUT=300
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Lab only: allow private IPs / .local hosts as scan targets
ASM_ALLOW_PRIVATE_TARGETS=false
# LAB_MS3_IP=192.168.16.128
# Multiply rate limit for nuclei/directory discovery (lab only; 1 = honor target rate_limit)
ASM_RATE_MULTIPLIER=1

# AI triage of change events (advisory; rules keep a severity floor). none | ollama | mock
ASM_LLM_PROVIDER=none
# ASM_LLM_BASE_URL=http://host.docker.internal:11434
# ASM_LLM_MODEL=qwen2.5:7b
# ASM_LLM_TIMEOUT=120
# Bounds per scan (the scan never waits on the model beyond these):
# ASM_LLM_MAX_EVENTS=30                 most severe confirmed events first; CVE version-match events are left to rules
# ASM_LLM_SEVERITY_MODE=advise          advise: AI explains, rules decide severity (default). adjust: AI may move it one step;
#                                       enable only for a model that passes `python -m backend.scripts.ai_eval`
# ASM_LLM_BUDGET_SECONDS=180
# ASM_LLM_MAX_CONSECUTIVE_FAILURES=2    stop for this scan when the model is down
